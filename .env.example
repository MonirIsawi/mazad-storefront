# Base URL of mazad-api, including its /api/v1 prefix.
# See ../mazad-api/README.md to run the backend locally.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# mazad-api serves uploaded photos at the server root (Nest's useStaticAssets bypasses the
# /api/v1 prefix), matching its own PUBLIC_ASSETS_BASE_URL — same host, different path.
NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3001/assets

# Public origin of this storefront (no path), e.g. https://mazad.example. Enables canonical URLs and
# absolute Open Graph links; leave unset until the production domain is final.
# NEXT_PUBLIC_SITE_URL=
# Server-only: mazad-api base URL for server-side metadata fetches, when it differs from
# NEXT_PUBLIC_API_URL (e.g. a private network address). Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=
